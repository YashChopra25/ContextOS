# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgres://contextos:contextos@localhost:5433/contextos

# Redis cache from docker-compose.yml (host port 6380). Leave empty to run without a cache.
REDIS_URL=redis://localhost:6380

# Tavily powers the Context Agent: web search, answers, page extraction and profile summaries.
# Without it the agent answers from ContextOS data only.
TAVILY_API_KEY=

# Optional — raises the GitHub API limit from 60 to 5,000 requests/hour for context syncs.
GITHUB_TOKEN=
